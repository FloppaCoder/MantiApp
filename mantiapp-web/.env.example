# Variables de entorno de la web de MantiApp.
# Copia este archivo como .env.local y reemplaza los valores por los de tu proyecto de Supabase
# (Supabase → Project Settings → API). No subas .env.local al repositorio.

# Dirección del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon). Es la que usa el navegador; nunca pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon
