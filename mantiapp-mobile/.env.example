# Origin of the Next.js server, WITHOUT /api at the end.
# Physical device: replace the example IP with your computer's LAN IPv4.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# Android Studio emulator: http://10.0.2.2:3000
# Production: https://your-deployed-web.example

# Same public Supabase project used by the web app, for authentication.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
